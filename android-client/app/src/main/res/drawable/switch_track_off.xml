<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="50dp" android:height="28dp" />
            <solid android:color="#18000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#D0D0D5"
                android:startColor="#F4F4F7"
                android:type="linear" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>